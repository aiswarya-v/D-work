    80                                    %define SEV_SNP_KERNEL_HASHES_SIZE (000000C00h + 000000400h)
    81                                  %else
    82                                    %define SEV_SNP_KERNEL_HASHES_BASE 0
    83                                    %define SEV_SNP_KERNEL_HASHES_SIZE 0
    84                                  %endif
    85                                  %define SNP_SEC_MEM_BASE_DESC_1 (000800000h)
    86                                  %define SNP_SEC_MEM_SIZE_DESC_1 (000809000h - SNP_SEC_MEM_BASE_DESC_1)
    87                                  ;
    88                                  ; The PcdOvmfSecGhcbBase reserves two GHCB pages. The first page is used
    89                                  ; as GHCB shared page and second is used for bookkeeping to support the
    90                                  ; nested GHCB in SEC phase. The bookkeeping page is mapped private. The VMM
    91                                  ; does not need to validate the shared page but it need to validate the
    92                                  ; bookkeeping page.
    93                                  ;
    94                                  %define SNP_SEC_MEM_BASE_DESC_2 (GHCB_BASE + 01000h)
    95                                  %define SNP_SEC_MEM_SIZE_DESC_2 (SEV_SNP_SECRETS_BASE - SNP_SEC_MEM_BASE_DESC_2)
    96                                  %define SNP_SEC_MEM_BASE_DESC_3 (SVSM_CAA_BASE + SVSM_CAA_SIZE + SEV_SNP_KERNEL_HASHES_SIZE)
    97                                  %define SNP_SEC_MEM_SIZE_DESC_3 (000830000h - SNP_SEC_MEM_BASE_DESC_3)
    98                                  
