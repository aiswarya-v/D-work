   159                              <1> ;------------------------------------------------------------------------------
   160                              <1> ; @file
   161                              <1> ; Provide the functions to check whether SEV and SEV-ES is enabled.
   162                              <1> ;
   163                              <1> ; Copyright (c) 2017 - 2021, Advanced Micro Devices, Inc. All rights reserved.<BR>
   164                              <1> ; SPDX-License-Identifier: BSD-2-Clause-Patent
   165                              <1> ;
   166                              <1> ;------------------------------------------------------------------------------
   167                              <1> 
   168                              <1> BITS    32
   169                              <1> 
   170                              <1> ;
   171                              <1> ; SEV-ES #VC exception handler support
   172                              <1> ;
   173                              <1> ; #VC handler local variable locations
   174                              <1> ;
   175                              <1> %define VC_CPUID_RESULT_EAX         0
   176                              <1> %define VC_CPUID_RESULT_EBX         4
   177                              <1> %define VC_CPUID_RESULT_ECX         8
   178                              <1> %define VC_CPUID_RESULT_EDX        12
   179                              <1> %define VC_GHCB_MSR_EDX            16
   180                              <1> %define VC_GHCB_MSR_EAX            20
   181                              <1> %define VC_CPUID_REQUEST_REGISTER  24
   182                              <1> %define VC_CPUID_FUNCTION          28
   183                              <1> 
   184                              <1> ; #VC handler total local variable size
   185                              <1> ;
   186                              <1> %define VC_VARIABLE_SIZE           32
   187                              <1> 
   188                              <1> ; #VC handler GHCB CPUID request/response protocol values
   189                              <1> ;
   190                              <1> %define GHCB_CPUID_REQUEST          4
   191                              <1> %define GHCB_CPUID_RESPONSE         5
   192                              <1> %define GHCB_CPUID_REGISTER_SHIFT  30
   193                              <1> %define CPUID_INSN_LEN              2
   194                              <1> 
   195                              <1> ; #VC handler offsets/sizes for accessing SNP CPUID page
   196                              <1> ;
   197                              <1> %define SNP_CPUID_ENTRY_SZ         48
   198                              <1> %define SNP_CPUID_COUNT             0
   199                              <1> %define SNP_CPUID_ENTRY            16
   200                              <1> %define SNP_CPUID_ENTRY_EAX_IN      0
   201                              <1> %define SNP_CPUID_ENTRY_ECX_IN      4
   202                              <1> %define SNP_CPUID_ENTRY_EAX        24
   203                              <1> %define SNP_CPUID_ENTRY_EBX        28
   204                              <1> %define SNP_CPUID_ENTRY_ECX        32
   205                              <1> %define SNP_CPUID_ENTRY_EDX        36
   206                              <1> 
   207                              <1> 
   208                              <1> %define SEV_GHCB_MSR                0xc0010130
   209                              <1> %define SEV_STATUS_MSR              0xc0010131
   210                              <1> 
   211                              <1> ; The #VC was not for CPUID
   212                              <1> %define TERM_VC_NOT_CPUID           1
   213                              <1> 
   214                              <1> ; The unexpected response code
   215                              <1> %define TERM_UNEXPECTED_RESP_CODE   2
   216                              <1> 
   217                              <1> %define PAGE_PRESENT            0x01
   218                              <1> %define PAGE_READ_WRITE         0x02
   219                              <1> %define PAGE_USER_SUPERVISOR    0x04
   220                              <1> %define PAGE_WRITE_THROUGH      0x08
   221                              <1> %define PAGE_CACHE_DISABLE     0x010
   222                              <1> %define PAGE_ACCESSED          0x020
   223                              <1> %define PAGE_DIRTY             0x040
   224                              <1> %define PAGE_PAT               0x080
   225                              <1> %define PAGE_GLOBAL           0x0100
   226                              <1> %define PAGE_2M_MBO            0x080
   227                              <1> %define PAGE_2M_PAT          0x01000
   228                              <1> 
   229                              <1> %define PAGE_4K_PDE_ATTR (PAGE_ACCESSED +                           PAGE_DIRTY +                           PAGE_READ_WRITE +                           PAGE_PRESENT)
   233                              <1> 
   234                              <1> %define PAGE_PDP_ATTR (PAGE_ACCESSED +                        PAGE_READ_WRITE +                        PAGE_PRESENT)
   237                              <1> 
   238                              <1> 
   239                              <1> ; Macro is used to issue the MSR protocol based VMGEXIT. The caller is
   240                              <1> ; responsible to populate values in the EDX:EAX registers. After the vmmcall
   241                              <1> ; returns, it verifies that the response code matches with the expected
   242                              <1> ; code. If it does not match then terminate the guest. The result of request
   243                              <1> ; is returned in the EDX:EAX.
   244                              <1> ;
   245                              <1> ; args 1:Request code, 2: Response code
   246                              <1> %macro VmgExit 2
   247                              <1>     ;
   248                              <1>     ; Add request code:
   249                              <1>     ;   GHCB_MSR[11:0]  = Request code
   250                              <1>     or      eax, %1
   251                              <1> 
   252                              <1>     mov     ecx, SEV_GHCB_MSR
   253                              <1>     wrmsr
   254                              <1> 
   255                              <1>     ; Issue VMGEXIT - NASM doesn't support the vmmcall instruction in 32-bit
   256                              <1>     ; mode, so work around this by temporarily switching to 64-bit mode.
   257                              <1>     ;
   258                              <1> BITS    64
   259                              <1>     rep     vmmcall
   260                              <1> BITS    32
   261                              <1> 
   262                              <1>     mov     ecx, SEV_GHCB_MSR
   263                              <1>     rdmsr
   264                              <1> 
   265                              <1>     ;
   266                              <1>     ; Verify the reponse code, if it does not match then request to terminate
   267                              <1>     ;   GHCB_MSR[11:0]  = Response code
   268                              <1>     mov     ecx, eax
   269                              <1>     and     ecx, 0xfff
   270                              <1>     cmp     ecx, %2
   271                              <1>     jne     SevEsUnexpectedRespTerminate
   272                              <1> %endmacro
   273                              <1> 
   274                              <1> ; Macro to terminate the guest using the VMGEXIT.
   275                              <1> ; arg 1: reason code
   276                              <1> %macro TerminateVmgExit 1
   277                              <1>     mov     eax, %1
   278                              <1>     ;
   279                              <1>     ; Use VMGEXIT to request termination. At this point the reason code is
   280                              <1>     ; located in EAX, so shift it left 16 bits to the proper location.
   281                              <1>     ;
   282                              <1>     ; EAX[11:0]  => 0x100 - request termination
   283                              <1>     ; EAX[15:12] => 0x1   - OVMF
   284                              <1>     ; EAX[23:16] => 0xXX  - REASON CODE
   285                              <1>     ;
