    49 00000AA7 E954F5FFFF          <2>  jmp %1
    50                              <2> %1 %+ OneTimerCallReturn:
   233                              <1> 
   234                              <1>     ;
   235                              <1>     ; EBP - Start of BFV
   236                              <1>     ;
   237                              <1> 
