   165                              <1> BITS 32
   166                              <1> 
   167                              <1> ;
   168                              <1> ; Check if it is Intel Tdx
   169                              <1> ;
   170                              <1> ; Modified: EAX, EBX, ECX, EDX
   171                              <1> ;
   172                              <1> ; If it is Intel Tdx, EAX is 1
   173                              <1> ; If it is not Intel Tdx, EAX is 0
   174                              <1> ;
   175                              <1> IsTdx:
   176                              <1>     ;
   177                              <1>     ; CPUID (0)
   178                              <1>     ;
   179 000004C8 B800000000          <1>     mov     eax, 0
   180 000004CD 0FA2                <1>     cpuid
   181 000004CF 81FB47656E75        <1>     cmp     ebx, 0x756e6547  ; "Genu"
   182 000004D5 7556                <1>     jne     IsNotTdx
   183 000004D7 81FA696E6549        <1>     cmp     edx, 0x49656e69  ; "ineI"
   184 000004DD 754E                <1>     jne     IsNotTdx
   185 000004DF 81F96E74656C        <1>     cmp     ecx, 0x6c65746e  ; "ntel"
   186 000004E5 7546                <1>     jne     IsNotTdx
   187                              <1> 
   188                              <1>     ;
   189                              <1>     ; CPUID (1)
   190                              <1>     ;
   191 000004E7 B801000000          <1>     mov     eax, 1
   192 000004EC 0FA2                <1>     cpuid
   193 000004EE F7C100000080        <1>     test    ecx, 0x80000000
   194 000004F4 7437                <1>     jz      IsNotTdx
   195                              <1> 
   196                              <1>     ;
   197                              <1>     ; CPUID[0].EAX >= 0x21?
   198                              <1>     ;
   199 000004F6 B800000000          <1>     mov     eax, 0
   200 000004FB 0FA2                <1>     cpuid
   201 000004FD 83F821              <1>     cmp     eax, 0x21
   202 00000500 7C2B                <1>     jl      IsNotTdx
   203                              <1> 
   204                              <1>     ;
   205                              <1>     ; CPUID (0x21,0)
   206                              <1>     ;
   207 00000502 B821000000          <1>     mov     eax, 0x21
   208 00000507 B900000000          <1>     mov     ecx, 0
   209 0000050C 0FA2                <1>     cpuid
   210                              <1> 
   211 0000050E 81FB496E7465        <1>     cmp     ebx, 0x65746E49   ; "Inte"
   212 00000514 7517                <1>     jne     IsNotTdx
   213 00000516 81FA6C544458        <1>     cmp     edx, 0x5844546C   ; "lTDX"
   214 0000051C 750F                <1>     jne     IsNotTdx
   215 0000051E 81F920202020        <1>     cmp     ecx, 0x20202020   ; "    "
   216 00000524 7507                <1>     jne     IsNotTdx
   217                              <1> 
   218 00000526 B801000000          <1>     mov     eax, 1
