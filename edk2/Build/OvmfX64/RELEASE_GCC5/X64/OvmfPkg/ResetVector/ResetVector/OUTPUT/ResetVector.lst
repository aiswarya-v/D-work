   172                              <1> 
   173                              <1> 
   174                              <1> BITS    16
   175                              <1> 
   176                              <1> ;
   177                              <1> ; Modified:  EBX, ECX, EDX, EBP
   178                              <1> ;
   179                              <1> ; @param[in,out]  RAX/EAX  Initial value of the EAX register
   180                              <1> ;                          (BIST: Built-in Self Test)
   181                              <1> ; @param[in,out]  DI       'BP': boot-strap processor, or
   182                              <1> ;                          'AP': application processor
   183                              <1> ; @param[out]     RBP/EBP  Address of Boot Firmware Volume (BFV)
   184                              <1> ; @param[out]     DS       Selector allowing flat access to all addresses
   185                              <1> ; @param[out]     ES       Selector allowing flat access to all addresses
   186                              <1> ; @param[out]     FS       Selector allowing flat access to all addresses
   187                              <1> ; @param[out]     GS       Selector allowing flat access to all addresses
   188                              <1> ; @param[out]     SS       Selector allowing flat access to all addresses
