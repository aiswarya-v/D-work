   229                              <1> ; Initialize work area if it is Tdx guest. Detailed definition is in
   230                              <1> ; OvmfPkg/Include/WorkArea.h.
   231                              <1> ; BSP and APs all go here. Only BSP initialize this work area.
   232                              <1> ;
   233                              <1> ; Param[in] EBX[5:0]    CPU Supported GPAW (48 or 52)
   234                              <1> ; Param[in] ESI[31:0]   vCPU ID (BSP is 0, others are AP)
   235                              <1> ;
   236                              <1> ; Modified:  EBX
   237                              <1> ;
   238                              <1> InitTdxWorkarea:
   239                              <1> 
   240                              <1>     ;
   241                              <1>     ; First check if it is Tdx
   242                              <1>     ;
   243                              <1>     OneTimeCall IsTdx
    49 00000531 EB95                <2>  jmp %1
    50                              <2> %1 %+ OneTimerCallReturn:
   244                              <1> 
   245 00000533 85C0                <1>     test    eax, eax
   246 00000535 7420                <1>     jz      ExitInitTdxWorkarea
   247                              <1> 
   248 00000537 83FE00              <1>     cmp     esi, 0
   249 0000053A 740B                <1>     je      TdxBspEntry
   250                              <1> 
   251                              <1>     ;
   252                              <1>     ; In Td guest, BSP/AP shares the same entry point
   253                              <1>     ; BSP builds up the page table, while APs shouldn't do the same task.
   254                              <1>     ; Instead, APs just leverage the page table which is built by BSP.
   255                              <1>     ; APs will wait until the page table is ready.
   256                              <1>     ;
   257                              <1> TdxApWait:
   258 0000053C 803D04B0800000      <1>     cmp     byte[TDX_WORK_AREA_PGTBL_READY], 0
   259 00000543 74F7                <1>     je      TdxApWait
   260 00000545 EB10                <1>     jmp     ExitInitTdxWorkarea
   261                              <1> 
   262                              <1> TdxBspEntry:
   263                              <1>     ;
   264                              <1>     ; Set Type of WORK_AREA_GUEST_TYPE so that the following code can use
   265                              <1>     ; these information.
   266                              <1>     ;
   267 00000547 C60500B0800002      <1>     mov     byte[WORK_AREA_GUEST_TYPE], VM_GUEST_TDX
   268                              <1> 
   269                              <1>     ;
   270                              <1>     ; EBX[5:0] CPU supported GPA width
   271                              <1>     ;
   272 0000054E 83E33F              <1>     and     ebx, 0x3f
   273 00000551 891D08B08000        <1>     mov     DWORD[TDX_WORK_AREA_GPAW], ebx
   274                              <1> 
   275                              <1> ExitInitTdxWorkarea:
   276                              <1>     OneTimeCallRet InitTdxWorkarea
    54 00000557 EB25                <2>  jmp %1 %+ OneTimerCallReturn
   277                              <1> 
   278                              <1> ;
   279                              <1> ; Load the GDT and set the CS/DS/ES/FS/GS/SS.
   280                              <1> ;
   281                              <1> ; Modified:  EAX, DS, ES, FS, GS, SS, CS
   282                              <1> ;
   283                              <1> ReloadFlat32:
   284                              <1> 
   285 00000559 FA                  <1>     cli
   286 0000055A B8A8FEFFFF          <1>     mov     eax, ADDR_OF(gdtr)
   287 0000055F 0F0110              <1>     lgdt    [eax]
   288                              <1> 
   289 00000562 EAD9F9FFFF1000      <1>     jmp     LINEAR_CODE_SEL:dword ADDR_OF(jumpToFlat32BitAndLandHere)
   290                              <1> 
   291                              <1> jumpToFlat32BitAndLandHere:
   292                              <1> 
   293                              <1>     debugShowPostCode POSTCODE_32BIT_MODE
   294                              <1> 
   295 00000569 66B81800            <1>     mov     ax, LINEAR_SEL
   296 0000056D 8ED8                <1>     mov     ds, ax
   297 0000056F 8EC0                <1>     mov     es, ax
   298 00000571 8EE0                <1>     mov     fs, ax
   299 00000573 8EE8                <1>     mov     gs, ax
   300 00000575 8ED0                <1>     mov     ss, ax
   301                              <1> 
   302                              <1>     OneTimeCallRet ReloadFlat32
    54 00000577 E921050000          <2>  jmp %1 %+ OneTimerCallReturn
   303                              <1> 
   304                              <1> ;
   305                              <1> ; Tdx initialization after entering into ResetVector
   306                              <1> ;
   307                              <1> ; Modified:  EAX, EBX, ECX, EDX, EBP, EDI, ESP
   308                              <1> ;
   309                              <1> InitTdx:
   310                              <1>     ;
   311                              <1>     ; Initialization of Tdx work area
   312                              <1>     ;
   313                              <1>     OneTimeCall  InitTdxWorkarea
    49 0000057C EBB3                <2>  jmp %1
    50                              <2> %1 %+ OneTimerCallReturn:
   314                              <1> 
   315                              <1>     OneTimeCallRet InitTdx
    54 0000057E E924050000          <2>  jmp %1 %+ OneTimerCallReturn
   316                              <1> 
   317                              <1> ;
   318                              <1> ; Check TDX features, TDX or TDX-BSP or TDX-APs?
   319                              <1> ;
   320                              <1> ; By design TDX BSP is reponsible for initializing the PageTables.
   321                              <1> ; After PageTables are ready, byte[TDX_WORK_AREA_PGTBL_READY] is set to 1.
   322                              <1> ; APs will spin when byte[TDX_WORK_AREA_PGTBL_READY] is 0 until it is set to 1.
   323                              <1> ;
   324                              <1> ; When this routine is run on TDX BSP, byte[TDX_WORK_AREA_PGTBL_READY] should be 0.
   325                              <1> ; When this routine is run on TDX APs, byte[TDX_WORK_AREA_PGTBL_READY] should be 1.
   326                              <1> ;
   327                              <1> ;
   328                              <1> ; Modified:  EAX, EDX
   329                              <1> ;
   330                              <1> ; 0-NonTdx, 1-TdxBsp, 2-TdxAps, 3-TdxAps5Level
   331                              <1> ;
   332                              <1> CheckTdxFeaturesBeforeBuildPagetables:
   333 00000583 31C0                <1>     xor     eax, eax
   334 00000585 803D00B0800002      <1>     cmp     byte[WORK_AREA_GUEST_TYPE], VM_GUEST_TDX
   335 0000058C 7508                <1>     jne     NotTdx
   336                              <1> 
   337 0000058E 31D2                <1>     xor     edx, edx
   338 00000590 A004B08000          <1>     mov     al, byte[TDX_WORK_AREA_PGTBL_READY]
   339 00000595 40                  <1>     inc     eax
   340                              <1> 
   341                              <1> NotTdx:
   342                              <1>     OneTimeCallRet CheckTdxFeaturesBeforeBuildPagetables
    54 00000596 E91DFDFFFF          <2>  jmp %1 %+ OneTimerCallReturn
   343                              <1> 
   344                              <1> ;
   345                              <1> ; Set byte[TDX_WORK_AREA_PGTBL_READY] to 1
   346                              <1> ;
   347                              <1> TdxPostBuildPageTables:
   348 0000059B C60504B0800001      <1>     mov     byte[TDX_WORK_AREA_PGTBL_READY], 1
   349                              <1>     OneTimeCallRet TdxPostBuildPageTables
    54 000005A2 E912FFFFFF          <2>  jmp %1 %+ OneTimerCallReturn
   350                              <1> 
   351                              <1> %if PG_5_LEVEL
   352                              <1> 
   353                              <1> ;
   354                              <1> ; Set byte[TDX_WORK_AREA_PGTBL_READY] to 2
   355                              <1> ;
   356                              <1> TdxPostBuildPageTables5Level:
   357                              <1>     mov     byte[TDX_WORK_AREA_PGTBL_READY], 2
   358                              <1>     OneTimeCallRet TdxPostBuildPageTables5Level
   359                              <1> 
   360                              <1> %endif
   361                              <1> 
   362                              <1> ;
   363                              <1> ; Check if TDX is enabled
   364                              <1> ;
   365                              <1> ; Modified:  EAX
   366                              <1> ;
   367                              <1> ; If TDX is enabled then EAX will be 1
   368                              <1> ; If TDX is disabled then EAX will be 0.
   369                              <1> ;
   370                              <1> IsTdxEnabled:
   371 000005A7 31C0                <1>     xor     eax, eax
   372 000005A9 803D00B0800002      <1>     cmp     byte[WORK_AREA_GUEST_TYPE], VM_GUEST_TDX
   373 000005B0 7505                <1>     jne     TdxNotEnabled
   374 000005B2 B801000000          <1>     mov     eax, 1
   375                              <1> 
   376                              <1> TdxNotEnabled:
   377                              <1>     OneTimeCallRet IsTdxEnabled
    54 000005B7 E97AFCFFFF          <2>  jmp %1 %+ OneTimerCallReturn
