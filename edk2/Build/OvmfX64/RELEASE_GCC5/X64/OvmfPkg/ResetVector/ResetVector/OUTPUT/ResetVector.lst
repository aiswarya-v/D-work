    49 00000A9D E922FEFFFF          <2>  jmp %1
    50                              <2> %1 %+ OneTimerCallReturn:
   224                              <1> 
   225                              <1>     OneTimeCall InitTdx
    49 00000AA2 E9D5FAFFFF          <2>  jmp %1
    50                              <2> %1 %+ OneTimerCallReturn:
   226                              <1> 
