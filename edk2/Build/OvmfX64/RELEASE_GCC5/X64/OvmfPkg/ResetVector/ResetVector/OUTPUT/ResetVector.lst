   150                                    %include "X64/IntelTdxMetadata.asm"
   151                              <1> ;------------------------------------------------------------------------------
   152                              <1> ; @file
   153                              <1> ; Tdx Virtual Firmware metadata
   154                              <1> ;
   155                              <1> ; When host VMM creates a new guest TD, some initial set of TD-private pages
   156                              <1> ; are added using the TDH.MEM.PAGE.ADD function. These pages typically contain
   157                              <1> ; Virtual BIOS code and data along with some clear pages for stacks and heap.
   158                              <1> ; In the meanwhile, some configuration data need be measured by host VMM.
   159                              <1> ; Tdx Metadata is designed for this purpose to indicate host VMM how to do the
   160                              <1> ; above tasks.
   161                              <1> ;
   162                              <1> ; Tdx Metadata consists of a DESCRIPTOR as the header followed by several
   163                              <1> ; SECTIONs. Host VMM sets up the memory for TDVF according to these sections.
   164                              <1> ;
   165                              <1> ; _Bfv is the example (Bfv refers to the Virtual BIOS code).
   166                              <1> ; - By DataOffset/RawDataSize host VMM knows about the position of the code
   167                              <1> ;   in the binary image.
   168                              <1> ; - MemoryAddress/MemoryDataSize indicates the guest physical address/size of
   169                              <1> ;   the Bfv to be loaded.
   170                              <1> ; - Type field means this section is of BFV. This field is designed for the
   171                              <1> ;   purpose that in some case host VMM may do some additional processing based
   172                              <1> ;   upon the section type. TdHob section is an example. Host VMM pass the
   173                              <1> ;   physical memory information to the guest firmware by writing the data in
   174                              <1> ;   the memory region designated by TdHob section.
   175                              <1> ; - By design code part of the binary image (Bfv) should be measured by host
   176                              <1> ;   VMM. This is indicated by the Attributes field.
   177                              <1> ;
   178                              <1> ; So put all these information together, when a new guest is being created,
   179                              <1> ; the initial TD-private pages for BFV is added by TDH.MEM.PAGE.ADD function,
   180                              <1> ; and Bfv is loaded at the guest physical address indicated by MemoryAddress.
   181                              <1> ; Since the Attributes is TDX_METADATA_ATTRIBUTES_EXTENDMR, Bfv is measured by
   182                              <1> ; host VMM.
   183                              <1> ;
   184                              <1> ; Copyright (c) 2021, Intel Corporation. All rights reserved.<BR>
   185                              <1> ; SPDX-License-Identifier: BSD-2-Clause-Patent
   186                              <1> ;
   187                              <1> ;------------------------------------------------------------------------------
   188                              <1> 
   189                              <1> BITS    64
   190                              <1> 
   191                              <1> %define TDX_METADATA_SECTION_TYPE_BFV       0
   192                              <1> %define TDX_METADATA_SECTION_TYPE_CFV       1
   193                              <1> %define TDX_METADATA_SECTION_TYPE_TD_HOB    2
   194                              <1> %define TDX_METADATA_SECTION_TYPE_TEMP_MEM  3
   195                              <1> %define TDX_METADATA_VERSION                1
   196                              <1> %define TDX_METADATA_ATTRIBUTES_EXTENDMR    0x00000001
   197                              <1> 
   198 0000013C 90<rep 4h>          <1> ALIGN   16
   199                              <1> TIMES (15 - ((TdxGuidedStructureEnd - TdxGuidedStructureStart + 15) % 16)) DB 0
   200                              <1> 
   201                              <1> TdxGuidedStructureStart:
   202                              <1> 
   203                              <1> ;
   204                              <1> ; TDVF meta data
   205                              <1> ;
   206                              <1> TdxMetadataGuid:
   207 00000140 F3F9EAE98E16D544    <1>   DB  0xf3, 0xf9, 0xea, 0xe9, 0x8e, 0x16, 0xd5, 0x44
   208 00000148 A8EB7F4D8738F6AE    <1>   DB  0xa8, 0xeb, 0x7f, 0x4d, 0x87, 0x38, 0xf6, 0xae
   209                              <1> 
   210                              <1> _Descriptor:
   211 00000150 54445646            <1>   DB 'T','D','V','F'                                  ; Signature
   212 00000154 D0000000            <1>   DD TdxGuidedStructureEnd - _Descriptor              ; Length
   213 00000158 01000000            <1>   DD TDX_METADATA_VERSION                             ; Version
   214 0000015C 06000000            <1>   DD (TdxGuidedStructureEnd - _Descriptor - 16)/32    ; Number of sections
   215                              <1> 
   216                              <1> _Bfv:
   217 00000160 00400800            <1>   DD TDX_BFV_RAW_DATA_OFFSET
   218 00000164 00C03700            <1>   DD TDX_BFV_RAW_DATA_SIZE
   219 00000168 0040C8FF00000000    <1>   DQ TDX_BFV_MEMORY_BASE
   220 00000170 00C0370000000000    <1>   DQ TDX_BFV_MEMORY_SIZE
   221 00000178 00000000            <1>   DD TDX_METADATA_SECTION_TYPE_BFV
   222 0000017C 01000000            <1>   DD TDX_METADATA_ATTRIBUTES_EXTENDMR
   223                              <1> 
   224                              <1> _Cfv:
   225 00000180 00000000            <1>   DD TDX_CFV_RAW_DATA_OFFSET
   226 00000184 00400800            <1>   DD TDX_CFV_RAW_DATA_SIZE
   227 00000188 0000C0FF00000000    <1>   DQ TDX_CFV_MEMORY_BASE
   228 00000190 0040080000000000    <1>   DQ TDX_CFV_MEMORY_SIZE
   229 00000198 01000000            <1>   DD TDX_METADATA_SECTION_TYPE_CFV
   230 0000019C 00000000            <1>   DD 0
   231                              <1> 
   232                              <1> _TdxHeapStack:
   233 000001A0 00000000            <1>   DD 0
   234 000001A4 00000000            <1>   DD 0
   235 000001A8 0040810000000000    <1>   DQ TDX_HEAP_STACK_BASE
   236 000001B0 00C0000000000000    <1>   DQ TDX_HEAP_STACK_SIZE
   237 000001B8 03000000            <1>   DD TDX_METADATA_SECTION_TYPE_TEMP_MEM
   238 000001BC 00000000            <1>   DD 0
   239                              <1> 
   240                              <1> _TdxInitMem:
   241 000001C0 00000000            <1>   DD 0
   242 000001C4 00000000            <1>   DD 0
   243 000001C8 00B0800000000000    <1>   DQ TDX_INIT_MEMORY_BASE
   244 000001D0 0020000000000000    <1>   DQ TDX_INIT_MEMORY_SIZE
   245 000001D8 03000000            <1>   DD TDX_METADATA_SECTION_TYPE_TEMP_MEM
   246 000001DC 00000000            <1>   DD 0
   247                              <1> 
   248                              <1> _TdHob:
   249 000001E0 00000000            <1>   DD 0
   250 000001E4 00000000            <1>   DD 0
   251 000001E8 0090800000000000    <1>   DQ TDX_HOB_MEMORY_BASE
   252 000001F0 0020000000000000    <1>   DQ TDX_HOB_MEMORY_SIZE
   253 000001F8 02000000            <1>   DD TDX_METADATA_SECTION_TYPE_TD_HOB
   254 000001FC 00000000            <1>   DD 0
   255                              <1> 
   256                              <1> _OvmfPageTable:
   257 00000200 00000000            <1>   DD 0
   258 00000204 00000000            <1>   DD 0
   259 00000208 0000800000000000    <1>   DQ OVMF_PAGE_TABLE_BASE
   260 00000210 0060000000000000    <1>   DQ OVMF_PAGE_TABLE_SIZE
   261 00000218 03000000            <1>   DD TDX_METADATA_SECTION_TYPE_TEMP_MEM
   262 0000021C 00000000            <1>   DD 0
   263                              <1> 
   264                              <1> TdxGuidedStructureEnd:
   265                              <1> ALIGN   16
   151                                    %include "Ia32/Flat32ToFlat64.asm"
   152                              <1> ;------------------------------------------------------------------------------
   153                              <1> ; @file
   154                              <1> ; Transition from 32 bit flat protected mode into 64 bit flat protected mode
   155                              <1> ;
   156                              <1> ; Copyright (c) 2008 - 2018, Intel Corporation. All rights reserved.<BR>
   157                              <1> ; Copyright (c) 2020, Advanced Micro Devices, Inc. All rights reserved.<BR>
   158                              <1> ; SPDX-License-Identifier: BSD-2-Clause-Patent
   159                              <1> ;
   160                              <1> ;------------------------------------------------------------------------------
   161                              <1> 
   162                              <1> BITS    32
   163                              <1> 
   164                              <1> ;
   165                              <1> ; Modified:  EAX, ECX, EDX
   166                              <1> ;
   167                              <1> Transition32FlatTo64Flat:
   168                              <1> 
   169                              <1>     OneTimeCall SetCr3ForPageTables64
    49 00000220 E98E000000          <2>  jmp %1
    50                              <2> %1 %+ OneTimerCallReturn:
   170                              <1> 
   171 00000225 0F20E0              <1>     mov     eax, cr4
   172 00000228 0FBAE805            <1>     bts     eax, 5                      ; enable PAE
   173 0000022C 0F22E0              <1>     mov     cr4, eax
   174                              <1> 
   175                              <1>     ;
   176                              <1>     ; In TDX LME has already been set. So we're done and jump to enable
   177                              <1>     ; paging directly if Tdx is enabled.
   178                              <1>     ; EBX is cleared because in the later it will be used to check if
   179                              <1>     ; the second step of the SEV-ES mitigation is to be performed.
   180                              <1>     ;
   181 0000022F 31DB                <1>     xor     ebx, ebx
   182                              <1>     OneTimeCall IsTdxEnabled
    49 00000231 E971030000          <2>  jmp %1
    50                              <2> %1 %+ OneTimerCallReturn:
   183 00000236 85C0                <1>     test    eax, eax
   184 00000238 7538                <1>     jnz     EnablePaging
   185                              <1> 
   186 0000023A B9800000C0          <1>     mov     ecx, 0xc0000080
   187 0000023F 0F32                <1>     rdmsr
   188 00000241 0FBAE808            <1>     bts     eax, 8                      ; set LME
   189 00000245 0F30                <1>     wrmsr
   190                              <1> 
   191                              <1>     ;
   192                              <1>     ; SEV-ES mitigation check support
   193                              <1>     ;
   194 00000247 31DB                <1>     xor     ebx, ebx
   195                              <1> 
   196 00000249 B901000000          <1>     mov     ecx, 1
   197 0000024E 0FA30D04B08000      <1>     bt      [SEV_ES_WORK_AREA_STATUS_MSR], ecx
   198 00000255 731B                <1>     jnc     EnablePaging
   199                              <1> 
   200                              <1>     ;
   201                              <1>     ; SEV-ES is active, perform a quick sanity check against the reported
   202                              <1>     ; encryption bit position. This is to help mitigate against attacks where
   203                              <1>     ; the hypervisor reports an incorrect encryption bit position.
   204                              <1>     ;
   205                              <1>     ; This is the first step in a two step process. Before paging is enabled
   206                              <1>     ; writes to memory are encrypted. Using the RDRAND instruction (available
   207                              <1>     ; on all SEV capable processors), write 64-bits of random data to the
   208                              <1>     ; SEV_ES_WORK_AREA and maintain the random data in registers (register
   209                              <1>     ; state is protected under SEV-ES). This will be used in the second step.
   210                              <1>     ;
   211                              <1> RdRand1:
   212 00000257 0FC7F1              <1>     rdrand  ecx
   213 0000025A 73FB                <1>     jnc     RdRand1
   214 0000025C 890D0CB08000        <1>     mov     dword[SEV_ES_WORK_AREA_RDRAND], ecx
   215                              <1> RdRand2:
   216 00000262 0FC7F2              <1>     rdrand  edx
   217 00000265 73FB                <1>     jnc     RdRand2
   218 00000267 891510B08000        <1>     mov     dword[SEV_ES_WORK_AREA_RDRAND + 4], edx
   219                              <1> 
   220                              <1>     ;
   221                              <1>     ; Use EBX instead of the SEV_ES_WORK_AREA memory to determine whether to
   222                              <1>     ; perform the second step.
   223                              <1>     ;
   224 0000026D BB01000000          <1>     mov     ebx, 1
   225                              <1> 
   226                              <1> EnablePaging:
   227 00000272 0F20C0              <1>     mov     eax, cr0
   228 00000275 0FBAE81F            <1>     bts     eax, 31                     ; set PG
   229 00000279 0F22C0              <1>     mov     cr0, eax                    ; enable paging
   230                              <1> 
   231                              <1>     ;
   232                              <1>     ; uninstall #vc exception handler
   233                              <1>     ;
   234                              <1>     OneTimeCall SevCpuidExit
    49 0000027C E956060000          <2>  jmp %1
    50                              <2> %1 %+ OneTimerCallReturn:
   235                              <1> 
   236 00000281 EAF8F6FFFF3800      <1>     jmp     LINEAR_CODE64_SEL:ADDR_OF(jumpTo64BitAndLandHere)
   237                              <1> BITS    64
   238                              <1> jumpTo64BitAndLandHere:
   239                              <1> 
   240                              <1>     ;
   241                              <1>     ; Check if the second step of the SEV-ES mitigation is to be performed.
   242                              <1>     ;
   243 00000288 85DB                <1>     test    ebx, ebx
   244 0000028A 7412                <1>     jz      InsnCompare
   245                              <1> 
   246                              <1>     ;
   247                              <1>     ; SEV-ES is active, perform the second step of the encryption bit postion
   248                              <1>     ; mitigation check. The ECX and EDX register contain data from RDRAND that
   249                              <1>     ; was stored to memory in encrypted form. If the encryption bit position is
   250                              <1>     ; valid, the contents of ECX and EDX will match the memory location.
   251                              <1>     ;
   252 0000028C 390C250CB08000      <1>     cmp     dword[SEV_ES_WORK_AREA_RDRAND], ecx
   253 00000293 7515                <1>     jne     SevEncBitHlt
   254 00000295 39142510B08000      <1>     cmp     dword[SEV_ES_WORK_AREA_RDRAND + 4], edx
   255 0000029C 750C                <1>     jne     SevEncBitHlt
   256                              <1> 
   257                              <1>     ;
   258                              <1>     ; If SEV or SEV-ES is active, perform a quick sanity check against
   259                              <1>     ; the reported encryption bit position. This is to help mitigate
   260                              <1>     ; against attacks where the hypervisor reports an incorrect encryption
   261                              <1>     ; bit position. If SEV is not active, this check will always succeed.
   262                              <1>     ;
   263                              <1>     ; The cmp instruction compares the first four bytes of the cmp instruction
   264                              <1>     ; itself (which will be read decrypted if SEV or SEV-ES is active and the
   265                              <1>     ; encryption bit position is valid) against the immediate within the
   266                              <1>     ; instruction (an instruction fetch is always decrypted correctly by
   267                              <1>     ; hardware) based on RIP relative addressing.
   268                              <1>     ;
   269                              <1> InsnCompare:
   270 0000029E 813DF6FFFFFF813DF6- <1>     cmp     dword[rel InsnCompare], 0xFFF63D81
   270 000002A7 FF                  <1>
   271 000002A8 7404                <1>     je      GoodCompare
   272                              <1> 
   273                              <1>     ;
   274                              <1>     ; The hypervisor provided an incorrect encryption bit position, do not
   275                              <1>     ; proceed.
   276                              <1>     ;
   277                              <1> SevEncBitHlt:
   278 000002AA FA                  <1>     cli
   279 000002AB F4                  <1>     hlt
   280 000002AC EBFC                <1>     jmp     SevEncBitHlt
   281                              <1> 
   282                              <1> GoodCompare:
   283                              <1>     debugShowPostCode POSTCODE_64BIT_MODE
   284                              <1> 
   285                              <1>     OneTimeCallRet Transition32FlatTo64Flat
    54 000002AE E903080000          <2>  jmp %1 %+ OneTimerCallReturn
   286                              <1> 
   152                                    %include "Ia32/PageTables64.asm"
   153                              <1> ;------------------------------------------------------------------------------
   154                              <1> ; @file
   155                              <1> ; Sets the CR3 register for 64-bit paging
   156                              <1> ;
   157                              <1> ; Copyright (c) 2008 - 2013, Intel Corporation. All rights reserved.<BR>
   158                              <1> ; Copyright (c) 2017 - 2020, Advanced Micro Devices, Inc. All rights reserved.<BR>
   159                              <1> ; SPDX-License-Identifier: BSD-2-Clause-Patent
   160                              <1> ;
   161                              <1> ;------------------------------------------------------------------------------
   162                              <1> 
   163                              <1> BITS    32
   164                              <1> 
   165                              <1> ; common for all levels
   166                              <1> %define PAGE_PRESENT            0x01
   167                              <1> %define PAGE_READ_WRITE         0x02
   168                              <1> %define PAGE_USER_SUPERVISOR    0x04
   169                              <1> %define PAGE_WRITE_THROUGH      0x08
   170                              <1> %define PAGE_CACHE_DISABLE     0x010
   171                              <1> %define PAGE_ACCESSED          0x020
   172                              <1> %define PAGE_DIRTY             0x040
   173                              <1> %define PAGE_GLOBAL           0x0100
   174                              <1> 
   175                              <1> ; page table entries (level 1)
   176                              <1> %define PAGE_PTE_PAT           0x080
   177                              <1> 
   178                              <1> ; page directory entries (level 2+)
   179                              <1> %define PAGE_PDE_LARGEPAGE     0x080
   180                              <1> %define PAGE_PDE_PAT         0x01000
   181                              <1> 
   182                              <1> %define PAGE_4K_PDE_ATTR (PAGE_ACCESSED +                           PAGE_DIRTY +                           PAGE_READ_WRITE +                           PAGE_PRESENT)
   186                              <1> 
   187                              <1> %define PAGE_PDE_LARGEPAGE_ATTR (PAGE_PDE_LARGEPAGE +                                  PAGE_ACCESSED +                                  PAGE_DIRTY +                                  PAGE_READ_WRITE +                                  PAGE_PRESENT)
   192                              <1> 
   193                              <1> %define PAGE_PDE_DIRECTORY_ATTR (PAGE_ACCESSED +                                  PAGE_READ_WRITE +                                  PAGE_PRESENT)
   196                              <1> 
   197                              <1> %define TDX_BSP         1
   198                              <1> %define TDX_AP          2
   199                              <1> %define TDX_AP_5_LEVEL  3
   200                              <1> 
   201                              <1> ;
   202                              <1> ; For OVMF, build some initial page tables at
   203                              <1> ; PcdOvmfSecPageTablesBase - (PcdOvmfSecPageTablesBase + 0x6000).
   204                              <1> ;
   205                              <1> ; This range should match with PcdOvmfSecPageTablesSize which is
   206                              <1> ; declared in the FDF files.
   207                              <1> ;
   208                              <1> ; At the end of PEI, the pages tables will be rebuilt into a
   209                              <1> ; more permanent location by DxeIpl.
   210                              <1> ;
   211                              <1> %macro ClearOvmfPageTables 0
   212                              <1>     mov     ecx, 6 * 0x1000 / 4
   213                              <1>     xor     eax, eax
   214                              <1> .clearPageTablesMemoryLoop:
   215                              <1>     mov     dword[ecx * 4 + PT_ADDR (0) - 4], eax
   216                              <1>     loop    .clearPageTablesMemoryLoop
   217                              <1> %endmacro
   218                              <1> 
   219                              <1> ;
   220                              <1> ; Create page tables for 4-level paging
   221                              <1> ;
   222                              <1> ; Argument: upper 32 bits of the leaf page table entries
   223                              <1> ;
   224                              <1> %macro CreatePageTables4Level 1
   225                              <1> 
   226                              <1>     ; indicate 4-level paging
   227                              <1>     debugShowPostCode 0x41
   228                              <1> 
   229                              <1>     ;
   230                              <1>     ; Top level Page Directory Pointers (1 * 512GB entry)
   231                              <1>     ;
   232                              <1>     mov     dword[PT_ADDR (0)], PT_ADDR (0x1000) + PAGE_PDE_DIRECTORY_ATTR
   233                              <1>     mov     dword[PT_ADDR (4)], 0
   234                              <1> 
   235                              <1>     ;
   236                              <1>     ; Next level Page Directory Pointers (4 * 1GB entries => 4GB)
   237                              <1>     ;
   238                              <1>     mov     dword[PT_ADDR (0x1000)], PT_ADDR (0x2000) + PAGE_PDE_DIRECTORY_ATTR
   239                              <1>     mov     dword[PT_ADDR (0x1004)], 0
   240                              <1>     mov     dword[PT_ADDR (0x1008)], PT_ADDR (0x3000) + PAGE_PDE_DIRECTORY_ATTR
   241                              <1>     mov     dword[PT_ADDR (0x100C)], 0
   242                              <1>     mov     dword[PT_ADDR (0x1010)], PT_ADDR (0x4000) + PAGE_PDE_DIRECTORY_ATTR
   243                              <1>     mov     dword[PT_ADDR (0x1014)], 0
   244                              <1>     mov     dword[PT_ADDR (0x1018)], PT_ADDR (0x5000) + PAGE_PDE_DIRECTORY_ATTR
   245                              <1>     mov     dword[PT_ADDR (0x101C)], 0
   246                              <1> 
   247                              <1>     ;
   248                              <1>     ; Page Table Entries (2048 * 2MB entries => 4GB)
   249                              <1>     ;
   250                              <1>     mov     ecx, 0x800
   251                              <1> .pageTableEntriesLoop4Level:
   252                              <1>     mov     eax, ecx
   253                              <1>     dec     eax
   254                              <1>     shl     eax, 21
   255                              <1>     add     eax, PAGE_PDE_LARGEPAGE_ATTR
   256                              <1>     mov     dword[ecx * 8 + PT_ADDR (0x2000 - 8)], eax
   257                              <1>     mov     dword[(ecx * 8 + PT_ADDR (0x2000 - 8)) + 4], %1
   258                              <1>     loop    .pageTableEntriesLoop4Level
   259                              <1> %endmacro
   260                              <1> 
   261                              <1> ;
   262                              <1> ; Check whenever 5-level paging can be used
   263                              <1> ;
   264                              <1> ; Argument: jump label for 4-level paging
   265                              <1> ;
   266                              <1> %macro Check5LevelPaging 1
   267                              <1>     ; check for cpuid leaf 0x07
   268                              <1>     mov     eax, 0x00
   269                              <1>     cpuid
   270                              <1>     cmp     eax, 0x07
   271                              <1>     jb      %1
   272                              <1> 
   273                              <1>     ; check for la57 (aka 5-level paging)
   274                              <1>     mov     eax, 0x07
   275                              <1>     mov     ecx, 0x00
   276                              <1>     cpuid
   277                              <1>     bt      ecx, 16
   278                              <1>     jnc     %1
   279                              <1> 
   280                              <1>     ; check for cpuid leaf 0x80000001
   281                              <1>     mov     eax, 0x80000000
   282                              <1>     cpuid
   283                              <1>     cmp     eax, 0x80000001
   284                              <1>     jb      %1
   285                              <1> 
   286                              <1>     ; check for 1g pages
   287                              <1>     mov     eax, 0x80000001
   288                              <1>     cpuid
   289                              <1>     bt      edx, 26
   290                              <1>     jnc     %1
   291                              <1> %endmacro
   292                              <1> 
   293                              <1> ;
   294                              <1> ; Create page tables for 5-level paging with gigabyte pages
   295                              <1> ;
   296                              <1> ; Argument: upper 32 bits of the leaf page table entries
   297                              <1> ;
   298                              <1> ; We have 6 pages available for the early page tables,
   299                              <1> ; we use four of them:
   300                              <1> ;    PT_ADDR(0)      - level 5 directory
   301                              <1> ;    PT_ADDR(0x1000) - level 4 directory
   302                              <1> ;    PT_ADDR(0x2000) - level 2 directory (0 -> 1GB)
   303                              <1> ;    PT_ADDR(0x3000) - level 3 directory
   304                              <1> ;
   305                              <1> ; The level 2 directory for the first gigabyte has the same
   306                              <1> ; physical address in both 4-level and 5-level paging mode,
   307                              <1> ; SevClearPageEncMaskForGhcbPage depends on this.
   308                              <1> ;
   309                              <1> ; The 1 GB -> 4 GB range is mapped using 1G pages in the
   310                              <1> ; level 3 directory.
   311                              <1> ;
   312                              <1> %macro CreatePageTables5Level 1
   313                              <1> 
   314                              <1>     ; indicate 5-level paging
   315                              <1>     debugShowPostCode 0x51
   316                              <1> 
   317                              <1>     ; level 5
   318                              <1>     mov     dword[PT_ADDR (0)], PT_ADDR (0x1000) + PAGE_PDE_DIRECTORY_ATTR
   319                              <1>     mov     dword[PT_ADDR (4)], 0
   320                              <1> 
   321                              <1>     ; level 4
   322                              <1>     mov     dword[PT_ADDR (0x1000)], PT_ADDR (0x3000) + PAGE_PDE_DIRECTORY_ATTR
   323                              <1>     mov     dword[PT_ADDR (0x1004)], 0
   324                              <1> 
   325                              <1>     ; level 3 (1x -> level 2, 3x 1GB)
   326                              <1>     mov     dword[PT_ADDR (0x3000)], PT_ADDR (0x2000) + PAGE_PDE_DIRECTORY_ATTR
   327                              <1>     mov     dword[PT_ADDR (0x3004)], 0
   328                              <1>     mov     dword[PT_ADDR (0x3008)], (1 << 30) + PAGE_PDE_LARGEPAGE_ATTR
   329                              <1>     mov     dword[PT_ADDR (0x300c)], %1
   330                              <1>     mov     dword[PT_ADDR (0x3010)], (2 << 30) + PAGE_PDE_LARGEPAGE_ATTR
   331                              <1>     mov     dword[PT_ADDR (0x3014)], %1
   332                              <1>     mov     dword[PT_ADDR (0x3018)], (3 << 30) + PAGE_PDE_LARGEPAGE_ATTR
   333                              <1>     mov     dword[PT_ADDR (0x301c)], %1
   334                              <1> 
   335                              <1>     ;
   336                              <1>     ; level 2 (512 * 2MB entries => 1GB)
   337                              <1>     ;
   338                              <1>     mov     ecx, 0x200
   339                              <1> .pageTableEntriesLoop5Level:
   340                              <1>     mov     eax, ecx
   341                              <1>     dec     eax
   342                              <1>     shl     eax, 21
   343                              <1>     add     eax, PAGE_PDE_LARGEPAGE_ATTR
   344                              <1>     mov     dword[ecx * 8 + PT_ADDR (0x2000 - 8)], eax
   345                              <1>     mov     dword[(ecx * 8 + PT_ADDR (0x2000 - 8)) + 4], %1
   346                              <1>     loop    .pageTableEntriesLoop5Level
   347                              <1> %endmacro
   348                              <1> 
   349                              <1> %macro Enable5LevelPaging 0
   350                              <1>     ; set la57 bit in cr4
   351                              <1>     mov     eax, cr4
   352                              <1>     bts     eax, 12
   353                              <1>     mov     cr4, eax
   354                              <1> %endmacro
