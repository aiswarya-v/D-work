   398                              <1>     ; Check for SEV memory encryption feature:
   399                              <1>     ; CPUID  Fn8000_001F[EAX] - Bit 1
   400                              <1>     ; Check for the COHERENCY_SFW_NO feature:
   401                              <1>     ; CPUID  Fn8000_001F[EBX] - Bit 31
