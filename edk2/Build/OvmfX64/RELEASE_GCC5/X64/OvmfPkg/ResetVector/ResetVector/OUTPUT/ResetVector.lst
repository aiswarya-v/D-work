    49 00000AAC E9C6F5FFFF          <2>  jmp %1
    50                              <2> %1 %+ OneTimerCallReturn:
   242                              <1> 
   243                              <1>     ;
   244                              <1>     ; ESI - SEC Core entry point
   245                              <1>     ; EBP - Start of BFV
   246                              <1>     ;
   247                              <1> 
   248                              <1> %ifdef ARCH_IA32
   249                              <1> 
   250                              <1>     ;
   251                              <1>     ; SEV support can be built and run using the Ia32/X64 split environment.
   252                              <1>     ; Set the OVMF/SEV work area as appropriate.
   253                              <1>     ;
   254                              <1>     OneTimeCall CheckSevFeatures
   255                              <1> 
   256                              <1>     ;
   257                              <1>     ; Restore initial EAX value into the EAX register
   258                              <1>     ;
   259                              <1>     mov     eax, esp
   260                              <1> 
   261                              <1>     ;
