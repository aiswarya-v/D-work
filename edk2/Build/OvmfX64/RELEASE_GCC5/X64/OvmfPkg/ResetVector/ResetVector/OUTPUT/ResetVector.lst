   285                              <1>     ; RSI - SEC Core entry point
   286                              <1>     ; RBP - Start of BFV
   287                              <1>     ;
   288                              <1> 
   289                              <1>     ;
   290                              <1>     ; Restore initial EAX value into the RAX register
   291                              <1>     ;
   292 00000AC4 4889E0              <1>     mov     rax, rsp
   293                              <1> 
   294                              <1>     ;
   295                              <1>     ; Jump to the 64-bit SEC entry point
   296                              <1>     ;
   297 00000AC7 FFE6                <1>     jmp     rsi
   298                              <1> 
   299                              <1> %endif
