   365                              <1> ; Check if Secure Encrypted Virtualization (SEV) features are enabled.
   366                              <1> ;
   367                              <1> ; Register usage is tight in this routine, so multiple calls for the
   368                              <1> ; same CPUID and MSR data are performed to keep things simple.
   369                              <1> ;
   370                              <1> ; Modified:  EAX, EBX, ECX, EDX, ESP
   371                              <1> ;
