   165                                    %define SEV_ES_AP_RESET_IP 8433668
   166                                    %define SEV_LAUNCH_SECRET_BASE 000810000h
   167                                    %define SEV_LAUNCH_SECRET_SIZE 000000C00h
   168                                    %define SEV_FW_HASH_BLOCK_BASE 000810C00h
