   170                                  %include "Ia16/ResetVectorVtf0.asm"
   171                              <1> ;------------------------------------------------------------------------------
   172                              <1> ; @file
   173                              <1> ; First code executed by processor after resetting.
   174                              <1> ; Derived from UefiCpuPkg/ResetVector/Vtf0/Ia16/ResetVectorVtf0.asm
   175                              <1> ;
   176                              <1> ; Copyright (c) 2008 - 2014, Intel Corporation. All rights reserved.<BR>
   177                              <1> ; SPDX-License-Identifier: BSD-2-Clause-Patent
   178                              <1> ;
   179                              <1> ;------------------------------------------------------------------------------
   180                              <1> 
   181                              <1> BITS    16
   182                              <1> 
   183 00000AC9 90<rep 7h>          <1> ALIGN   16
   184                              <1> 
   185                              <1> ;
   186                              <1> ; Pad the image size to 4k when page tables are in VTF0
   187                              <1> ;
   188                              <1> ; If the VTF0 image has page tables built in, then we need to make
   189                              <1> ; sure the end of VTF0 is 4k above where the page tables end.
   190                              <1> ;
   191                              <1> ; This is required so the page tables will be 4k aligned when VTF0 is
   192                              <1> ; located just below 0x100000000 (4GB) in the firmware device.
   193                              <1> ;
   194                              <1> %ifdef ALIGN_TOP_TO_4K_FOR_PAGING
   195                              <1>     TIMES (0x1000 - ($ - EndOfPageTables) - 0x20) DB 0
   196                              <1> %endif
   197                              <1> 
   198                              <1> ;
   199                              <1> ; Padding to ensure first guid starts at 0xffffffd0
   200                              <1> ;
   201 00000AD0 00<rep 2h>          <1> TIMES (15 - ((guidedStructureEnd - guidedStructureStart + 15) % 16)) DB 0
   202                              <1> 
   203                              <1> ; GUIDed structure.  To traverse this you should first verify the
   204                              <1> ; presence of the table footer guid
   205                              <1> ; (96b582de-1fb2-45f7-baea-a366c55a082d) at 0xffffffd0.  If that
   206                              <1> ; is found, the two bytes at 0xffffffce are the entire table length.
   207                              <1> ;
   208                              <1> ; The table is composed of structures with the form:
   209                              <1> ;
   210                              <1> ; Data (arbitrary bytes identified by guid)
   211                              <1> ; length from start of data to end of guid (2 bytes)
   212                              <1> ; guid (16 bytes)
   213                              <1> ;
   214                              <1> ; so work back from the footer using the length to traverse until you
   215                              <1> ; either find the guid you're looking for or run off the beginning of
   216                              <1> ; the table.
   217                              <1> ;
   218                              <1> guidedStructureStart:
   219                              <1> 
   220                              <1> %ifdef ARCH_X64
   221                              <1> ;
   222                              <1> ; IGVM Metadata offset block
   223                              <1> ;
   224                              <1> ; GUID : 784fa70e-3176-4677-8a20-04b68699e374
   225                              <1> ;
   226                              <1> igvmMetadataOffsetStart:
   227 00000AD2 60050000            <1>     DD      fourGigabytes - IgvmParamStart
   228 00000AD6 1600                <1>     DW      igvmMetadataOffsetEnd - igvmMetadataOffsetStart
   229 00000AD8 0EA74F7876317746    <1>     DB      0x0E, 0xA7, 0x4F, 0x78, 0x76, 0x31, 0x77, 0x46
   230 00000AE0 8A2004B68699E374    <1>     DB      0x8A, 0x20, 0x04, 0xB6, 0x86, 0x99, 0xE3, 0x74
   231                              <1> igvmMetadataOffsetEnd:
   232                              <1> 
   233                              <1> ;
   234                              <1> ; TDX Metadata offset block
   235                              <1> ;
   236                              <1> ; TdxMetadata.asm is included in ARCH_X64 because Inte TDX is only
   237                              <1> ; available in ARCH_X64. Below block describes the offset of
   238                              <1> ; TdxMetadata block in Ovmf image
   239                              <1> ;
   240                              <1> ; GUID : e47a6535-984a-4798-865e-4685a7bf8ec2
   241                              <1> ;
   242                              <1> tdxMetadataOffsetStart:
   243 00000AE8 400A0000            <1>     DD      fourGigabytes - TdxMetadataGuid - 16
   244 00000AEC 1600                <1>     DW      tdxMetadataOffsetEnd - tdxMetadataOffsetStart
   245 00000AEE 35657AE44A989847    <1>     DB      0x35, 0x65, 0x7a, 0xe4, 0x4a, 0x98, 0x98, 0x47
   246 00000AF6 865E4685A7BF8EC2    <1>     DB      0x86, 0x5e, 0x46, 0x85, 0xa7, 0xbf, 0x8e, 0xc2
   247                              <1> tdxMetadataOffsetEnd:
   248                              <1> 
   249                              <1> ;
   250                              <1> ; SEV metadata descriptor
   251                              <1> ;
   252                              <1> ; Provide the start offset of the metadata blob within the OVMF binary.
   253                              <1> 
   254                              <1> ; GUID : dc886566-984a-4798-A75e-5585a7bf67cc
   255                              <1> ;
   256                              <1> OvmfSevMetadataOffsetStart:
   257 00000AFE C4050000            <1>   DD      (fourGigabytes - OvmfSevMetadataGuid)
   258 00000B02 1600                <1>   DW      OvmfSevMetadataOffsetEnd - OvmfSevMetadataOffsetStart
   259 00000B04 666588DC4A989847    <1>   DB      0x66, 0x65, 0x88, 0xdc, 0x4a, 0x98, 0x98, 0x47
   260 00000B0C A75E5585A7BF67CC    <1>   DB      0xA7, 0x5e, 0x55, 0x85, 0xa7, 0xbf, 0x67, 0xcc
   261                              <1> OvmfSevMetadataOffsetEnd:
   262                              <1> 
   263                              <1> %endif
   264                              <1> 
   265                              <1> ; SEV Hash Table Block
   266                              <1> ;
   267                              <1> ; This describes the guest ram area where the hypervisor should
   268                              <1> ; install a table describing the hashes of certain firmware configuration
   269                              <1> ; device files that would otherwise be passed in unchecked.  The current
   270                              <1> ; use is for the kernel, initrd and command line values, but others may be
   271                              <1> ; added.  The data format is:
   272                              <1> ;
   273                              <1> ; base physical address (32 bit word)
   274                              <1> ; table length (32 bit word)
   275                              <1> ;
   276                              <1> ; GUID (SEV FW config hash block): 7255371f-3a3b-4b04-927b-1da6efa8d454
   277                              <1> ;
   278                              <1> sevFwHashBlockStart:
   279 00000B14 000C8100            <1>     DD      SEV_FW_HASH_BLOCK_BASE
   280 00000B18 00040000            <1>     DD      SEV_FW_HASH_BLOCK_SIZE
   281 00000B1C 1A00                <1>     DW      sevFwHashBlockEnd - sevFwHashBlockStart
   282 00000B1E 1F3755723B3A044B    <1>     DB      0x1f, 0x37, 0x55, 0x72, 0x3b, 0x3a, 0x04, 0x4b
   283 00000B26 927B1DA6EFA8D454    <1>     DB      0x92, 0x7b, 0x1d, 0xa6, 0xef, 0xa8, 0xd4, 0x54
   284                              <1> sevFwHashBlockEnd:
   285                              <1> 
   286                              <1> ; SEV Secret block
   287                              <1> ;
   288                              <1> ; This describes the guest ram area where the hypervisor should
   289                              <1> ; inject the secret.  The data format is:
   290                              <1> ;
   291                              <1> ; base physical address (32 bit word)
   292                              <1> ; table length (32 bit word)
   293                              <1> ;
   294                              <1> ; GUID (SEV secret block): 4c2eb361-7d9b-4cc3-8081-127c90d3d294
   295                              <1> ;
   296                              <1> sevSecretBlockStart:
   297 00000B2E 00008100            <1>     DD      SEV_LAUNCH_SECRET_BASE
   298 00000B32 000C0000            <1>     DD      SEV_LAUNCH_SECRET_SIZE
   299 00000B36 1A00                <1>     DW      sevSecretBlockEnd - sevSecretBlockStart
   300 00000B38 61B32E4C9B7DC34C    <1>     DB      0x61, 0xB3, 0x2E, 0x4C, 0x9B, 0x7D, 0xC3, 0x4C
   301 00000B40 8081127C90D3D294    <1>     DB      0x80, 0x81, 0x12, 0x7C, 0x90, 0xD3, 0xD2, 0x94
   302                              <1> sevSecretBlockEnd:
   303                              <1> 
   304                              <1> ;
   305                              <1> ; SEV-ES Processor Reset support
   306                              <1> ;
   307                              <1> ; sevEsResetBlock:
   308                              <1> ;   For the initial boot of an AP under SEV-ES, the "reset" RIP must be
   309                              <1> ;   programmed to the RAM area defined by SEV_ES_AP_RESET_IP. The data
   310                              <1> ;   format is:
   311                              <1> ;
   312                              <1> ;   IP value [0:15]
   313                              <1> ;   CS segment base [31:16]
   314                              <1> ;
   315                              <1> ;   GUID (SEV-ES reset block): 00f771de-1a7e-4fcb-890e-68c77e2fb44e
   316                              <1> ;
   317                              <1> ;   A hypervisor reads the CS segement base and IP value. The CS segment base
   318                              <1> ;   value represents the high order 16-bits of the CS segment base, so the
   319                              <1> ;   hypervisor must left shift the value of the CS segement base by 16 bits to
   320                              <1> ;   form the full CS segment base for the CS segment register. It would then
   321                              <1> ;   program the EIP register with the IP value as read.
   322                              <1> ;
   323                              <1> 
   324                              <1> sevEsResetBlockStart:
   325 00000B48 04B08000            <1>     DD      SEV_ES_AP_RESET_IP
   326 00000B4C 1600                <1>     DW      sevEsResetBlockEnd - sevEsResetBlockStart
   327 00000B4E DE71F7007E1ACB4F    <1>     DB      0xDE, 0x71, 0xF7, 0x00, 0x7E, 0x1A, 0xCB, 0x4F
   328 00000B56 890E68C77E2FB44E    <1>     DB      0x89, 0x0E, 0x68, 0xC7, 0x7E, 0x2F, 0xB4, 0x4E
   329                              <1> sevEsResetBlockEnd:
   330                              <1> 
   331                              <1> ;
   332                              <1> ; Table footer:
   333                              <1> ;
   334                              <1> ; length of whole table (16 bit word)
   335                              <1> ; GUID (table footer): 96b582de-1fb2-45f7-baea-a366c55a082d
   336                              <1> ;
   337 00000B5E 9E00                <1>     DW      guidedStructureEnd - guidedStructureStart
   338 00000B60 DE82B596B21FF745    <1>     DB      0xDE, 0x82, 0xB5, 0x96, 0xB2, 0x1F, 0xF7, 0x45
   339 00000B68 BAEAA366C55A082D    <1>     DB      0xBA, 0xEA, 0xA3, 0x66, 0xC5, 0x5A, 0x08, 0x2D
   340                              <1> 
   341                              <1> guidedStructureEnd:
   342                              <1> 
   343                              <1> ALIGN   16
   344                              <1> 
   345                              <1> ;
   346                              <1> ; 0xffffffe0
   347                              <1> ;
   348 00000B70 000000000000000000- <1>     DD      0, 0, 0
   348 00000B79 000000              <1>
   349                              <1> 
   350                              <1> ;
   351                              <1> ; The VTF signature (0xffffffec)
   352                              <1> ;
   353                              <1> ; VTF-0 means that the VTF (Volume Top File) code does not require
   354                              <1> ; any fixups.
   355                              <1> ;
   356                              <1> vtfSignature:
   357 00000B7C 56544600            <1>     DB      'V', 'T', 'F', 0
   358                              <1> 
   359                              <1> ALIGN   16
   360                              <1> 
   361                              <1> resetVector:
   362                              <1> ;
   363                              <1> ; Reset Vector
   364                              <1> ;
   365                              <1> ; This is where the processor will begin execution
   366                              <1> ;
   367                              <1> ; In IA32 we follow the standard reset vector flow. While in X64, Td guest
   368                              <1> ; may be supported. Td guest requires the startup mode to be 32-bit
   369                              <1> ; protected mode but the legacy VM startup mode is 16-bit real mode.
   370                              <1> ; To make NASM generate such shared entry code that behaves correctly in
   371                              <1> ; both 16-bit and 32-bit mode, more BITS directives are added.
   372                              <1> ;
   373                              <1> %ifdef ARCH_IA32
   374                              <1>     nop
   375                              <1>     nop
   376                              <1>     jmp     EarlyBspInitReal16
   377                              <1> 
   378                              <1> %else
   379                              <1> 
   380 00000B80 0F20C0              <1>     mov     eax, cr0
   381 00000B83 A801                <1>     test    al, 1
   382 00000B85 7405                <1>     jz      .Real
   383                              <1> BITS 32
   384 00000B87 E90CFFFFFF          <1>     jmp     Main32
   385                              <1> BITS 16
   386                              <1> .Real:
   387 00000B8C E9F1FE              <1>     jmp     EarlyBspInitReal16
   388                              <1> 
   389                              <1> %endif
   390                              <1> 
   391 00000B8F 90                  <1> ALIGN   16
   392                              <1> 
   393                              <1> fourGigabytes:
   394                              <1> 
