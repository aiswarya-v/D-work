   277                              <1>     ; 32-bits of 64-bit registers are zero for these values.
   278                              <1>     ;
   279 00000AB6 B8FFFFFFFF          <1>     mov     rax, 0x00000000ffffffff
   280 00000ABB 4821C6              <1>     and     rsi, rax
   281 00000ABE 4821C5              <1>     and     rbp, rax
   282 00000AC1 4821C4              <1>     and     rsp, rax
