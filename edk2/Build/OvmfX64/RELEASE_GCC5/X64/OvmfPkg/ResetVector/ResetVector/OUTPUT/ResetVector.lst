   315 00000A77 00                  <1>     DB      0            ; base 31:24
   316                              <1> 
   317                              <1> ; linear code (64-bit) segment descriptor
   318                              <1> LINEAR_CODE64_SEL   equ $-GDT_BASE    ; Selector [0x38]
   319 00000A78 FFFF                <1>     DW      0xffff       ; limit 15:0
   320 00000A7A 0000                <1>     DW      0            ; base 15:0
   321 00000A7C 00                  <1>     DB      0            ; base 23:16
   322 00000A7D 9B                  <1>     DB      PRESENT_FLAG(1)|DPL(0)|SYSTEM_FLAG(1)|DESC_TYPE(CODE64_TYPE)           ; 09Bh
   323 00000A7E AF                  <1>     DB      GRANULARITY_FLAG(1)|DEFAULT_SIZE32(0)|CODE64_FLAG(1)|UPPER_LIMIT(0xf)  ; 0AFh
   324 00000A7F 00                  <1>     DB      0            ; base 31:24
   325                              <1> 
