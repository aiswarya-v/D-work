   200 000005CC 41534556            <1>   DB 'A','S','E','V'                                        ; Signature
   201 000005D0 64000000            <1>   DD OvmfSevGuidedStructureEnd - _DescriptorSev             ; Length
   202 000005D4 01000000            <1>   DD OVMF_SEV_METADATA_VERSION                              ; Version
   203 000005D8 07000000            <1>   DD (OvmfSevGuidedStructureEnd - _DescriptorSev - 16) / 12 ; Number of sections
   204                              <1> 
   205                              <1> ; Region need to be pre-validated by the hypervisor
   206                              <1> PreValidate1:
   207 000005DC 00008000            <1>   DD  SNP_SEC_MEM_BASE_DESC_1
   208 000005E0 00900000            <1>   DD  SNP_SEC_MEM_SIZE_DESC_1
   209 000005E4 01000000            <1>   DD  OVMF_SECTION_TYPE_SNP_SEC_MEM
   210                              <1> PreValidate2:
   211 000005E8 00A08000            <1>   DD  SNP_SEC_MEM_BASE_DESC_2
   212 000005EC 00300000            <1>   DD  SNP_SEC_MEM_SIZE_DESC_2
   213 000005F0 01000000            <1>   DD  OVMF_SECTION_TYPE_SNP_SEC_MEM
   214                              <1> 
   215                              <1> ; SEV-SNP Secrets page
   216                              <1> SevSnpSecrets:
   217 000005F4 00D08000            <1>   DD  SEV_SNP_SECRETS_BASE
   218 000005F8 00100000            <1>   DD  SEV_SNP_SECRETS_SIZE
   219 000005FC 02000000            <1>   DD  OVMF_SECTION_TYPE_SNP_SECRETS
   220                              <1> 
   221                              <1> ; CPUID values
   222                              <1> CpuidSec:
   223 00000600 00E08000            <1>   DD  CPUID_BASE
   224 00000604 00100000            <1>   DD  CPUID_SIZE
   225 00000608 03000000            <1>   DD  OVMF_SECTION_TYPE_CPUID
   226                              <1> 
   227                              <1> ; SVSM CAA page
   228                              <1> SvsmCaa:
   229 0000060C 00F08000            <1>   DD  SVSM_CAA_BASE
   230 00000610 00100000            <1>   DD  SVSM_CAA_SIZE
   231 00000614 04000000            <1>   DD  OVMF_SECTION_TYPE_SVSM_CAA
   232                              <1> 
   233                              <1> ; Region need to be pre-validated by the hypervisor
   234                              <1> PreValidate3:
   235 00000618 00108100            <1>   DD  SNP_SEC_MEM_BASE_DESC_3
   236 0000061C 00F00100            <1>   DD  SNP_SEC_MEM_SIZE_DESC_3
   237 00000620 01000000            <1>   DD  OVMF_SECTION_TYPE_SNP_SEC_MEM
   238                              <1> 
   239                              <1> %if (SEV_SNP_KERNEL_HASHES_BASE > 0)
   240                              <1> ; Kernel hashes for measured direct boot, or zero page if
   241                              <1> ; there are no kernel hashes / SEV secrets
   242                              <1> SevSnpKernelHashes:
   243 00000624 00008100            <1>   DD  SEV_SNP_KERNEL_HASHES_BASE
   244 00000628 00100000            <1>   DD  SEV_SNP_KERNEL_HASHES_SIZE
   245 0000062C 10000000            <1>   DD  OVMF_SECTION_TYPE_KERNEL_HASHES
   246                              <1> %endif
   247                              <1> 
   248                              <1> OvmfSevGuidedStructureEnd:
   249                              <1>   ALIGN   16
