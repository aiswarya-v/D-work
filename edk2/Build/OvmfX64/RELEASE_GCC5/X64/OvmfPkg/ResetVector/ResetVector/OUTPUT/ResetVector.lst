   163                              <1> 
   164                              <1> BITS  64
   165                              <1> 
   166                              <1> %define OVMF_SEV_METADATA_VERSION     1
   167                              <1> 
   168                              <1> ; The section must be accepted or validated by the VMM before the boot
   169                              <1> %define OVMF_SECTION_TYPE_SNP_SEC_MEM     0x1
   170                              <1> 
   171                              <1> ; AMD SEV-SNP specific sections
   172                              <1> %define OVMF_SECTION_TYPE_SNP_SECRETS     0x2
   173                              <1> 
   174                              <1> ;
   175                              <1> ; The section contains the hypervisor pre-populated CPUID values.
   176                              <1> ; In the case of SEV-SNP, the CPUID values are filtered and measured by
   177                              <1> ; the SEV-SNP firmware.
   178                              <1> ; The CPUID format is documented in SEV-SNP firmware spec 0.9 section 7.1
   179                              <1> ; (CPUID function structure).
   180                              <1> ;
   181                              <1> %define OVMF_SECTION_TYPE_CPUID           0x3
   182                              <1> 
   183                              <1> ; The SVSM Calling Area Address (CAA)
   184                              <1> %define OVMF_SECTION_TYPE_SVSM_CAA        0x4
   185                              <1> 
   186                              <1> ; Kernel hashes section for measured direct boot
   187                              <1> %define OVMF_SECTION_TYPE_KERNEL_HASHES   0x10
   188                              <1> 
   189 000005BC 90<rep 4h>          <1> ALIGN 16
   190                              <1> 
   191 000005C0 00<rep Ch>          <1> TIMES (15 - ((OvmfSevGuidedStructureEnd - OvmfSevGuidedStructureStart + 15) % 16)) DB 0
   192                              <1> 
   193                              <1> OvmfSevGuidedStructureStart:
   194                              <1> ;
   195                              <1> ; OvmfSev metadata descriptor
   196                              <1> ;
   197                              <1> OvmfSevMetadataGuid:
   198                              <1> 
